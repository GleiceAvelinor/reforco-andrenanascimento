# ─────────────────────────────────────────────────────────────────────────────
# .env.example – Variáveis de ambiente para o projeto RAN-SITE
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANTE:
#  • Copie este arquivo para ".env.local" e preencha os valores reais.
#  • NUNCA commite o arquivo ".env.local" (já está no .gitignore).
#  • NUNCA exponha chaves aqui; este arquivo é apenas documentação.
# ─────────────────────────────────────────────────────────────────────────────

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 – Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Meta (Facebook) Pixel ────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Número no formato internacional sem + ou espaços
NEXT_PUBLIC_WHATSAPP_PHONE=5585985363010

# ── Site URL (usado em canonical, OG, sitemap) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=https://reforcoandrenascimento.com.br
